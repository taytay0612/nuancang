{
  "name": "nuancang",
  "version": "1.0.0",
  "private": true,
  "description": "暖仓 · 储藏室编码管理",
  "main": "electron/main.js",
  "author": "暖仓",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.nuancang.desktop",
    "productName": "暖仓",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/index.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "暖仓.exe",
      "unpackDirName": "nuancang"
    }
  }
}
